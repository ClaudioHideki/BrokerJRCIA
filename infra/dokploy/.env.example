# Copy into Dokploy environment. These are names only, never working credentials.
# Use immutable image digest after an approved GHCR release.
JRC_API_IMAGE=ghcr.io/claudiohideki/brokerjrcia-api@sha256:replace
JRC_WEB_IMAGE=ghcr.io/claudiohideki/brokerjrcia-web@sha256:replace
EVOLUTION_ENGINE_IMAGE=replace-with-reviewed-pinned-engine-image
PUBLIC_ORIGIN=https://broker.example.com
# Host only, without scheme, port or path. Must match the host in PUBLIC_ORIGIN.
# Omit to keep the existing jrc-broker.jrcws.cloud Traefik route.
BROKER_HOST=broker.example.com
# Use unique values if multiple Broker stacks share one Docker/Traefik host.
# Omit both to preserve identifiers used by the existing installation.
# BROKER_STACK_NAME=broker-customer-a
# BROKER_ROUTE_ID=broker-customer-a
# Generate DISTINCT random hex passwords >=32 characters (URL safe).
POSTGRES_PASSWORD=
JRC_APP_PASSWORD=
JRC_AUTH_PASSWORD=
JRC_PLATFORM_PASSWORD=
EVOLUTION_DB_PASSWORD=
REDIS_PASSWORD=
EVOLUTION_API_KEY=
JWT_SECRET=
REFRESH_TOKEN_HASH_SECRET=
API_KEY_HMAC_SECRET=
IP_RATE_LIMIT_HMAC_SECRET=
IDENTITY_RATE_LIMIT_HMAC_SECRET=
CHALLENGE_ENCRYPTION_KEY=
BROWSER_CSRF_SECRET=
# Exactly32 random bytes, encoded base64; distinct keys, back up securely.
PLATFORM_MFA_KEY=
PLATFORM_LOGIN_MODE=password_totp
INTEGRATION_ENCRYPTION_KEY=
QR_WEBHOOK_SIGNING_KEY=
# Optional managed JRC Conversas origin; leave empty for external-only customers.
CHATWOOT_BASE_URL=
# Optional: self-hosted Chatwoot Platform App token for automated account provisioning.
CHATWOOT_PLATFORM_TOKEN=
# Additional exact HTTPS origins only if Chatwoot uses external object storage.
CHATWOOT_MEDIA_ORIGINS=
# New destination administration surface. Keep off until the external transport gate passes.
CHATWOOT_EXTERNAL_DESTINATIONS_ENABLED=false
CHATWOOT_CONTROL_ENABLED=false
CHATWOOT_EMBED_ENABLED=false
# Existing approved destinations continue delivery when this registration flag is false.
# External-only installations leave CHATWOOT_BASE_URL and CHATWOOT_PLATFORM_TOKEN empty.
# Keep PUBLIC_ORIGIN and INTEGRATION_ENCRYPTION_KEY configured for persistent workers.
MEDIA_STORAGE_BYTES_PER_ORGANIZATION=1073741824
META_TOKEN_ENCRYPTION_KEY=
# JRC-owned Meta application, no customer app secrets in the browser.
META_APP_ID=
META_APP_SECRET=
META_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_CREDENTIALS_JSON={}
META_ASSET_BINDINGS_JSON={}
TYPEBOT_ORIGINS_JSON={}
# Automatic discovery. For separate worker services, use distinct shard numbers 0..N-1.
MESSAGING_WORKER_SHARDS=1
MESSAGING_WORKER_SHARD=0
# Enable only after migration 0027 and the execution, I/O and sandbox services are healthy.
AUTOMATION_RUNTIME_V2_ENABLED=false
AUTOMATION_WORKER_INTERVAL_MS=1000
AUTOMATION_IO_WORKER_INTERVAL_MS=1000
# Each version is a distinct canonical base64 encoding of exactly 32 random bytes.
# Preserve previous versions while encrypted credentials still reference them.
CREDENTIAL_VAULT_KEYS_JSON={"1":"REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES"}
# Independent random token with at least 32 characters, shared by sandbox and I/O worker.
AUTOMATION_SANDBOX_TOKEN=replace-with-at-least-32-random-characters
SCHEDULER_WORKER_INTERVAL_MS=1000
