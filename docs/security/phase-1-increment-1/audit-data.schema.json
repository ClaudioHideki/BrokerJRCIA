{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jrc.example/schemas/security-audit-v1.json",
  "title": "JRC Security Audit Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "findings", "strengths"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "strengths": {
      "type": "array",
      "items": { "$ref": "#/$defs/strength" }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": ["file", "lineStart", "lineEnd", "evidencePaths"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "evidencePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "category", "severity", "status", "control", "file",
        "lineStart", "lineEnd", "codeExcerptMasked", "description", "impact",
        "exploitability", "exploitConditions", "remediation", "acceptanceCriteria",
        "verification", "suggestedLabels", "issueMarkdown", "evidencePaths"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
        "status": { "enum": ["OPEN", "ACCEPTED", "FIXED", "NOT_APPLICABLE"] },
        "control": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "codeExcerptMasked": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "exploitability": { "type": "string", "minLength": 1 },
        "exploitConditions": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "verification": { "type": "string", "minLength": 1 },
        "suggestedLabels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "issueMarkdown": { "type": "string", "minLength": 1 },
        "evidencePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "title", "description", "file", "lineStart", "lineEnd", "evidencePaths"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "evidencePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "category": {
      "enum": [
        "MULTITENANT_ISOLATION", "AUTHORIZATION_RBAC", "IDOR", "SECRETS_CRYPTOGRAPHY",
        "INPUTS_XSS", "AUTHENTICATION", "RATE_LIMITING", "LOGGING_AUDIT",
        "PROVIDER_BOUNDARY", "IDEMPOTENCY_DOS", "SUPPLY_CHAIN", "OPENAPI_ROUTES",
        "CONTAINER_RUNTIME"
      ]
    }
  }
}
