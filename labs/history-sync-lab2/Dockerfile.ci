# syntax=docker/dockerfile:1.7
# Test-only image. The named lab2 context is exported from an exact Git SHA.
FROM ruby:3.4.12-bookworm AS minio-download
RUN curl --fail --silent --show-error --location --retry 3 \
    https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-amd64.RELEASE.2025-09-07T16-13-09Z \
    --output /minio \
 && echo '7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f  /minio' | sha256sum --check --status \
 && chmod 0755 /minio

FROM scratch AS minio
COPY --from=minio-download /minio /minio
ENV HOME=/tmp
ENTRYPOINT ["/minio"]

FROM ruby:3.4.12-bookworm AS rails
RUN apt-get update && apt-get install --no-install-recommends -y \
    libpq-dev libvips42 imagemagick poppler-utils ffmpeg libicu-dev cmake nodejs \
 && rm -rf /var/lib/apt/lists/*
RUN gem install bundler --version 2.5.16 --no-document
WORKDIR /testapp
COPY --from=lab2 Gemfile Gemfile.lock ./
ENV BUNDLE_FROZEN=true BUNDLE_JOBS=2 BUNDLE_RETRY=3
RUN bundle _2.5.16_ install
COPY --from=lab2 . .
COPY labs/history-sync-lab2/rails-initializer.rb /evidence/history-rails-initializer.rb
COPY labs/history-sync-lab2/http-data.rb /evidence/history-http-data.rb
COPY labs/history-sync-lab2/prepare-storage.rb /evidence/prepare-storage.rb
COPY labs/history-sync-lab2/start-ci.sh /evidence/start-ci.sh
RUN chmod 0755 /evidence/start-ci.sh \
 && sed -i 's/\r$//' /evidence/start-ci.sh bin/rails
ENTRYPOINT ["/evidence/start-ci.sh"]
